    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Scriban" Version="5.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="templates/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>