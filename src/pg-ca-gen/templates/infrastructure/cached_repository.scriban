using System;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.Caching.Memory;
using Domain.Common;

namespace {{namespace}}
{
    public sealed class CachedRepository<TEntity, TKey> : IRepository<TEntity, TKey>
        where TEntity : class
    {
        private readonly IRepository<TEntity, TKey> _inner;
        private readonly IMemoryCache _cache;
        private readonly MemoryCacheEntryOptions _options;
        private static readonly bool _enabled = Attribute.IsDefined(typeof(TEntity), typeof(CacheableAttribute));

        public CachedRepository(IRepository<TEntity, TKey> inner, IMemoryCache cache)
        {
            _inner = inner;
            _cache = cache;
            _options = new MemoryCacheEntryOptions { SlidingExpiration = TimeSpan.FromMinutes(10) };
        }

        private string CacheKey(TKey id) => $"{typeof(TEntity).Name}:{id}";

        public async Task<TEntity?> GetByIdAsync(TKey id, CancellationToken ct = default)
        {
            if (!_enabled) return await _inner.GetByIdAsync(id, ct);

            var key = CacheKey(id!);
            if (_cache.TryGetValue(key, out TEntity? existing)) return existing;
            var entity = await _inner.GetByIdAsync(id, ct);
            if (entity != null) _cache.Set(key, entity, _options);
            return entity;
        }

        public async Task AddAsync(TEntity entity, CancellationToken ct = default)
        {
            await _inner.AddAsync(entity, ct);
            if (_enabled) _cache.Compact(1.0);
        }

        public async Task UpdateAsync(TEntity entity, CancellationToken ct = default)
        {
            await _inner.UpdateAsync(entity, ct);
            if (_enabled) _cache.Compact(1.0);
        }

        public async Task DeleteAsync(TEntity entity, CancellationToken ct = default)
        {
            await _inner.DeleteAsync(entity, ct);
            if (_enabled) _cache.Compact(1.0);
        }

        public IQueryable<TEntity> Query() => _inner.Query();
    }
}